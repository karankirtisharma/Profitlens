# Local development only. Choose your own passwords; never commit .env.
POSTGRES_PASSWORD=replace-this-local-password
DATABASE_URL=postgresql+psycopg://profitlens:replace-this-local-password@localhost:5432/profitlens
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
STORAGE_DIR=data/uploads
SESSION_HOURS=8
# Passed only to the explicit synthetic seed command; minimum 12 characters.
DEMO_PASSWORD=
# Optional hosted explanations. Leave disabled until reviewed and configured.
# Supported providers: disabled, openrouter, nvidia. Never use NEXT_PUBLIC for keys.
AI_PROVIDER=disabled
AI_MODEL=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
AI_TIMEOUT_SECONDS=30

# Local defaults. See docs/VERCEL_FREE_DEPLOYMENT.md for hosted settings.
APP_ENV=development
DATABASE_POOL_MODE=queue
STORAGE_BACKEND=local
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Optional cap in bytes; unset preserves local CSV 5 MiB / PDF 10 MiB limits.
# UPLOAD_LIMIT_BYTES=4000000
